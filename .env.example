# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://invertedforest.com

# ── Supabase (optional — without it the site runs in demo/seed mode) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ — it bypasses row level
# security and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into /admin (Supabase mode).
# Sign-in is by emailed link at /admin-login; an address that is not on
# this list can authenticate and still see nothing.
ADMIN_EMAILS=

# ── Allpay ──────────────────────────────────────────────────────────────
# From Settings → API Integrations in the Allpay dashboard. One integration
# serves the whole site: payments are created per enrollment through the
# API, so there is no per-group link and no per-link secret to manage.
#
# Without these three the site falls back to each study group's hand-made
# payment link, which cannot carry an order id — those payments arrive
# unattached and have to be matched by hand in the admin panel.
ALLPAY_LOGIN=
ALLPAY_API_KEY=
# Signs inbound webhooks. Rotate it in the dashboard if it is ever pasted
# into a chat, a screenshot or a ticket.
ALLPAY_WEBHOOK_SECRET=
# VAT percentage applied to course line items. Set to 0 for a business not
# registered to charge VAT (עוסק פטור). This also decides whether the price
# shown on a course page is VAT-inclusive — check it with the accountant
# rather than trusting the default.
ALLPAY_VAT_RATE=18

# ── Telegram ────────────────────────────────────────────────────────────
# The bot must be an administrator of every private group channel, with
# rights to invite users and to restrict members.
TELEGRAM_BOT_TOKEN=
# Echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token header on every
# delivery to /api/telegram/webhook. Any long random string.
TELEGRAM_WEBHOOK_SECRET=
# Where operational failures are posted — an orphaned payment, a group with
# no channel, a member who could not be removed. Nobody reads a log table.
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated Telegram user ids allowed to run /grant. The bot webhook
# is a public endpoint; without this list the command is disabled.
TELEGRAM_ADMIN_USER_IDS=

# ── Email (Resend) ──────────────────────────────────────────────────────
# Carries the Telegram invite and the past-due notice. Verify the sending
# domain and publish SPF, DKIM and DMARC before going live: the invite link
# expires in seven days, so a message in a spam folder is a lost student.
# Unset is survivable — the invite is also shown on the page Allpay returns
# the payer to, which is why that page exists.
RESEND_API_KEY=
EMAIL_FROM="Inverted Forest <hello@invertedforest.com>"

# ── Scheduled work ──────────────────────────────────────────────────────
# Vercel Cron calls /api/cron/tick hourly with this as a bearer token.
# That sweep is where a missed monthly charge is detected — Allpay does not
# send a webhook for a failed recurring charge — so it is not optional.
CRON_SECRET=

# ── Automation (Make.com) ───────────────────────────────────────────────
# Make is a subscriber, not the orchestrator: every domain event is written
# to Supabase first and then posted here. Leave unset and nothing breaks.
MAKE_EVENTS_WEBHOOK_URL=
# Legacy: registration events for the existing Make → Sheets pipeline.
MAKE_REGISTRATION_WEBHOOK_URL=
# Legacy: shared secret for the pre-Allpay generic webhook.
PAYMENT_WEBHOOK_SECRET=

# ── Legal entity (named in the Terms and Conditions) ────────────────────
# The opening clause of the Terms identifies the contracting party.
# Set all three before publishing.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_REG_NUMBER=
NEXT_PUBLIC_LEGAL_ADDRESS=

# ── Contact / social ────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=hello@invertedforest.com
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/invertedforest
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/972000000000
